<?xml version="1.0" encoding="utf-8"?>
<!-- Секреты сопряжения не переносятся ни в облачный бэкап, ни на новое устройство. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="mars_sync_secure.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="mars_sync_secure.xml" />
    </device-transfer>
</data-extraction-rules>
