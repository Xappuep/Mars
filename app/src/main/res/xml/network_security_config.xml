<?xml version="1.0" encoding="utf-8"?>
<!--
  Синхронизация с ПК идёт только по HTTPS с пиннингом сертификата из QR
  (см. sync/TlsFingerprint.kt). Незашифрованный трафик запрещён полностью.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
